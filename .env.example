# Supabase — public values, safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_, never import from a "use client" file.
# Used only in Server Actions / Route Handlers that require bypassing RLS (e.g. admin moderation).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Used only to fetch the player's persona name/avatar on first Steam
# login (https://steamcommunity.com/dev/apikey). Steam login still works
# without it — the profile is just created with a generic username.
STEAM_WEB_API_KEY=
